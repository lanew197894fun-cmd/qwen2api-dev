{
  "services": [
    {
      "name": "qwen2api",
      "port": 3000,
      "cwd": "qwen2api",
      "cmd": ["bun", "src/start.js"],
      "env": {},
      "waitUrl": "http://127.0.0.1:3000/health",
      "waitTimeout": 30,
      "platforms": ["win32", "linux", "darwin"]
    },
    {
      "name": "chat-proxy",
      "port": 3456,
      "cwd": "qwen2api-plugin",
      "cmd": ["bun", "src/start-proxy.js"],
      "env": {},
      "waitUrl": "http://127.0.0.1:3456/health",
      "waitTimeout": 15,
      "platforms": ["win32", "linux", "darwin"]
    },
    {
      "name": "telegram-bridge",
      "port": 4377,
      "cwd": "telegram-memory-bridge",
      "cmd": ["bun", "src/index.ts"],
      "env": {},
      "waitUrl": "http://127.0.0.1:4377/api/health",
      "waitTimeout": 20,
      "platforms": ["win32", "linux", "darwin"]
    }
  ],
  "ports": [3000, 3456, 4377]
}
