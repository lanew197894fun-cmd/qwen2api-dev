# 必要：Telegram Bot Token（找 @BotFather 建立）
# 支援明文或 ~ENC~ 加密格式（執行 bun tools/encrypt-env.ts 自動加密）
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# 選擇性：Telegram Chat/Channel ID（用於備份/同步）
# 預設使用第一個發訊息的 user chat
MEMORY_CHAT_ID=

# 選擇性：HTTP API 埠（預設 4377）
API_PORT=4377

# 選擇性：記憶檔案路徑（預設 ../.opencode/memory）
MEMORY_PATH=../../.opencode/memory

# 選擇性：知識庫路徑（預設 ../.opencode/knowledge）
KNOWLEDGE_PATH=../../.opencode/knowledge

# 選擇性：維基路徑（預設 ../.opencode/wiki）
WIKI_PATH=../../.opencode/wiki

# ─────────────────────────────────────────────
# 🔐 加密設定
# ─────────────────────────────────────────────
# 1. 產生金鑰:  bun tools/generate-key.ts
#    （自動存到 ~/.opencode/encryption.key）
# 2. 加密 .env: bun tools/encrypt-env.ts
#    （將 TELEGRAM_BOT_TOKEN 和 API_KEY 轉為 ~ENC~ 格式）
# 3. 啟動腳本會自動讀取 ~/.opencode/encryption.key
#    無金鑰時回溯相容，直接使用明文值
